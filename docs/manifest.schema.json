{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Fiavaion/AlikaR/docs/manifest.schema.json",
  "title": "Cuardach .arhunt manifest, schema version 1",
  "description": "manifest.json at the root of a .arhunt bundle. Readers must preserve keys they do not understand (additionalProperties is open everywhere), and treat unknown enum values as 'not supported by this version', not as errors.",
  "type": "object",
  "required": ["schemaVersion", "id", "elements"],
  "properties": {
    "schemaVersion": { "type": "integer", "minimum": 1 },
    "id": { "type": "string", "minLength": 1 },
    "title": { "type": "string" },
    "author": { "type": "string" },
    "created": { "type": "string", "description": "ISO 8601 timestamp." },
    "cover": { "$ref": "#/$defs/path" },
    "siteHint": {
      "type": "object",
      "required": ["lat", "long"],
      "properties": {
        "lat": { "$ref": "#/$defs/lat" },
        "long": { "$ref": "#/$defs/long" },
        "radiusM": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "elements": { "type": "array", "items": { "$ref": "#/$defs/element" } },
    "label": { "$ref": "#/$defs/wallLabel" },
    "annotations": { "type": "array", "items": { "$ref": "#/$defs/critNote" } },
    "completionMessage": { "type": "string" }
  },
  "$defs": {
    "path": {
      "type": "string",
      "description": "Bundle-relative path with '/' separators. No leading '/', no '..' segments.",
      "pattern": "^(?!/)(?!.*(^|/)\\.\\.?(/|$))[^\\\\:]+$"
    },
    "lat": { "type": "number", "minimum": -90, "maximum": 90 },
    "long": { "type": "number", "minimum": -180, "maximum": 180 },
    "vec3": { "type": "array", "items": { "type": "number" }, "minItems": 3, "maxItems": 3 },
    "quat": { "type": "array", "items": { "type": "number" }, "minItems": 4, "maxItems": 4, "description": "[x, y, z, w]" },
    "transform": {
      "type": "object",
      "properties": {
        "position": { "$ref": "#/$defs/vec3", "description": "Metres." },
        "rotation": { "$ref": "#/$defs/quat" },
        "scale": { "$ref": "#/$defs/vec3" }
      }
    },
    "element": {
      "type": "object",
      "required": ["id", "kind"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string" },
        "kind": { "type": "string", "description": "model | video | image | audio | splat | text (Studio)", "examples": ["model", "video", "image", "audio", "splat", "text"] },
        "asset": { "$ref": "#/$defs/path" },
        "transform": { "$ref": "#/$defs/transform" },
        "anchors": { "type": "array", "items": { "$ref": "#/$defs/anchor" } },
        "behaviours": { "type": "array", "items": { "$ref": "#/$defs/behaviour" } },
        "state": { "type": "string", "description": "Initial state: 'hidden', 'visible', 'found' or a custom value." },
        "playback": {
          "type": "object",
          "properties": {
            "clip": { "type": "string" },
            "loop": { "type": "boolean" },
            "speed": { "type": "number" },
            "muted": { "type": "boolean" },
            "chromaKey": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
            "chromaTolerance": { "type": "number" },
            "audioFalloffM": { "type": "number" }
          }
        },
        "faceViewer": { "type": "boolean" },
        "label": { "$ref": "#/$defs/wallLabel" },
        "credit": { "$ref": "#/$defs/credit" },
        "variants": { "type": "array", "items": { "$ref": "#/$defs/variant" } },
        "designSize": {
          "type": "object",
          "required": ["widthM", "heightM", "depthM"],
          "properties": {
            "widthM": { "type": "number", "exclusiveMinimum": 0 },
            "heightM": { "type": "number", "exclusiveMinimum": 0 },
            "depthM": { "type": "number", "exclusiveMinimum": 0 },
            "lockScale": { "type": "boolean" }
          }
        },
        "text": { "type": "string" }
      }
    },
    "anchor": {
      "type": "object",
      "required": ["id", "tier"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "tier": { "type": "string", "examples": ["geo", "worldmap", "image", "object", "gps"] },
        "priority": { "type": "integer", "description": "Lower resolves first; ties use geo, image, worldmap, object, gps." },
        "lat": { "$ref": "#/$defs/lat" },
        "long": { "$ref": "#/$defs/long" },
        "alt": { "type": "number" },
        "heading": { "type": "number" },
        "mapFile": { "$ref": "#/$defs/path" },
        "anchorTransform": { "type": "array", "items": { "type": "number" }, "description": "Column-major 4×4 (16 numbers)." },
        "capturedAt": { "type": "string" },
        "mappingStatus": { "type": "string", "examples": ["mapped", "extending", "limited", "notAvailable"] },
        "imageFile": { "$ref": "#/$defs/path" },
        "physicalWidthM": { "type": "number", "exclusiveMinimum": 0 },
        "referenceObjectFile": { "$ref": "#/$defs/path" },
        "transform": { "$ref": "#/$defs/transform", "description": "image/object: the element's pose relative to the detected anchor." },
        "radiusM": { "type": "number", "exclusiveMinimum": 0 },
        "allowPlaneFallback": { "type": "boolean" }
      },
      "allOf": [
        { "if": { "properties": { "tier": { "const": "geo" } } }, "then": { "required": ["lat", "long"] } },
        { "if": { "properties": { "tier": { "const": "worldmap" } } }, "then": { "required": ["mapFile"] } },
        { "if": { "properties": { "tier": { "const": "image" } } }, "then": { "required": ["imageFile", "physicalWidthM"] } },
        { "if": { "properties": { "tier": { "const": "object" } } }, "then": { "required": ["referenceObjectFile"] } },
        { "if": { "properties": { "tier": { "const": "gps" } } }, "then": { "required": ["lat", "long"] } }
      ]
    },
    "behaviour": {
      "type": "object",
      "required": ["trigger"],
      "properties": {
        "id": { "type": "string" },
        "trigger": { "type": "string", "examples": ["start", "tap", "proximityEnter", "proximityExit", "dwell", "timeWindow"] },
        "retrigger": { "type": "string", "examples": ["immediately", "afterComplete", "never"] },
        "actions": {
          "type": "array",
          "description": "Sequential steps; each step is a list of actions that run in parallel.",
          "items": { "type": "array", "items": { "$ref": "#/$defs/action" } }
        },
        "proximityM": { "type": "number", "exclusiveMinimum": 0 },
        "dwellS": { "type": "number", "exclusiveMinimum": 0 },
        "window": {
          "type": "object",
          "required": ["from", "to"],
          "properties": {
            "from": { "type": "string", "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$" },
            "to": { "type": "string", "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$" }
          }
        }
      }
    },
    "action": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": { "type": "string", "examples": ["playAnimation", "stopAnimation", "show", "hide", "moveTo", "rotate", "scale", "playAudio", "playVideo", "delay", "setState", "setVariant", "cycleVariant"] },
        "target": { "type": "string", "description": "Element id; defaults to the behaviour's own element." },
        "clip": { "type": "string" },
        "loop": { "type": "boolean" },
        "speed": { "type": "number" },
        "duration": { "type": "number", "minimum": 0 },
        "position": { "$ref": "#/$defs/vec3" },
        "degrees": { "type": "number" },
        "factor": { "type": "number", "exclusiveMinimum": 0 },
        "asset": { "$ref": "#/$defs/path" },
        "volume": { "type": "number", "minimum": 0, "maximum": 1 },
        "seconds": { "type": "number", "minimum": 0 },
        "value": { "type": "string" },
        "variant": { "type": "string" }
      }
    },
    "wallLabel": {
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "artist": { "type": "string" },
        "year": { "type": "string" },
        "medium": { "type": "string" },
        "dimensions": { "type": "string" },
        "statement": { "type": "string" },
        "altText": { "type": "string" },
        "audioDescription": { "$ref": "#/$defs/path" }
      }
    },
    "credit": {
      "type": "object",
      "properties": {
        "creator": { "type": "string" },
        "source": { "type": "string" },
        "licence": { "type": "string", "description": "SPDX-style id where possible, e.g. CC-BY-4.0, CC0-1.0, Own-work, All-rights-reserved." },
        "url": { "type": "string" },
        "notes": { "type": "string" }
      }
    },
    "variant": {
      "type": "object",
      "required": ["id", "asset"],
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "asset": { "$ref": "#/$defs/path" },
        "note": { "type": "string" }
      }
    },
    "critNote": {
      "type": "object",
      "required": ["id"],
      "properties": {
        "id": { "type": "string" },
        "author": { "type": "string" },
        "kind": { "type": "string", "examples": ["question", "suggestion", "strength", "issue"] },
        "text": { "type": "string" },
        "created": { "type": "string" },
        "elementId": { "type": "string" },
        "offset": { "$ref": "#/$defs/vec3" },
        "resolved": { "type": "boolean" },
        "reply": { "type": "string" }
      }
    }
  }
}
